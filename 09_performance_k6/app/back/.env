# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_BIND=0.0.0.0:5000

# Redis (desarrollo local: localhost, Docker: redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# PostgreSQL (desarrollo local: localhost:5433, Docker: postgres:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ticketpass

# Negocio
RESERVA_TTL_SEGUNDOS=180
MAX_ENTRADAS_POR_PEDIDO=5

# Cola
COLA_TIMEOUT_SEGUNDOS=10
